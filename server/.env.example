# Copy to server/.env and fill in. Never commit the real file.

# ── Supabase ─────────────────────────────────────────────────────────────
# Project Settings → Database → Connection string → Session pooler (port 5432).
# The session pooler is the right one for a long-lived Express process; the
# transaction pooler on 6543 does not support prepared statements.
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# ── Cloudinary ───────────────────────────────────────────────────────────
# Dashboard → Product Environment Credentials. The dashboard also shows a
# single CLOUDINARY_URL of the form
#   cloudinary://<api_key>:<api_secret>@<cloud_name>
# which is the same three values; split it into the fields below.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Everything uploaded is namespaced under this folder.
CLOUDINARY_FOLDER=canvas-emporium

# ── Sessions ─────────────────────────────────────────────────────────────
# Optional. Generated into server/data/.session-secret on first run when unset.
# Set it explicitly in production so redeploys do not sign everybody out.
# SESSION_SECRET=

# ── First run only ───────────────────────────────────────────────────────
# Used by the seeder when the users table is empty. Ignored afterwards.
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=
